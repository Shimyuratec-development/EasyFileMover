<Window x:Name="NortifiWindow1" x:Class="EasyFileMover.NortifiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EasyFileMover"
        mc:Ignorable="d"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanMinimize"
        Title="通知" Height="200" Width="400" Icon="/EFM.ico">
    <Grid Background="#FF393F4C" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.754"/>
            <ColumnDefinition Width="63.246"/>
            <ColumnDefinition Width="44*"/>
            <ColumnDefinition Width="23*"/>
        </Grid.ColumnDefinitions>


        <TextBlock x:Name="NortifiTextBox" Margin="8,10,10,10" TextWrapping="Wrap"  Foreground="White" Grid.ColumnSpan="3" Grid.Column="1"/>
        <Button x:Name="OKButton" Content="OK"  Width="75" Margin="0,144,0,0"  HorizontalAlignment="Center" VerticalAlignment="Top" Click="OKButton_Click" Grid.Column="3"/>
    </Grid>
</Window>
