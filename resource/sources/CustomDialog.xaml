<Window x:Class="EasyFileMover.CustomDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="確認" Height="200" Width="400" Icon="/EFM.ico" >
    <Grid Background="#393f4c">
        <TextBlock x:Name="MessageTextBlock" Text="{Binding Message}" Margin="10" TextWrapping="Wrap" Foreground="White"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10">
            <Button Content="はい" Width="75" Margin="5" Click="YesButton_Click"/>
            <Button Content="いいえ" Width="75" Margin="5" Click="NoButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
