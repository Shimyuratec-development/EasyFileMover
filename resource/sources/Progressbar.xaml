<Window x:Class="EasyFileMover.Progressbar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EasyFileMover"
        mc:Ignorable="d"
        Title="進行率" Height="350" Width="800"
        ResizeMode="CanMinimize" Icon="/EFM.ico">
    <Grid Background="#393f4c" Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="1.5*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="0.5*" />

        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="45*" />
            <ColumnDefinition Width="440*" />
            <ColumnDefinition Width="158*"/>
            <ColumnDefinition Width="35*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding NowProcessing.Item}"  TextWrapping="Wrap"  Background="White" Margin="5,13,5,8" Grid.ColumnSpan="2"/>
        <ProgressBar Grid.Column="1" Grid.Row="1" Minimum="0" Maximum="100"  Value="{Binding NowProcessing.Progress}" Grid.ColumnSpan="2" Margin="0,31,0,33"/>
        <Button Content="完了" Grid.Column="2" Grid.Row="2" Margin="10,5,0,5" HorizontalAlignment="Left" IsEnabled="{Binding NowProcessing.CanFinish}" Command="{Binding CloseWindowCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Click="Button_Click" Width="69"/>
        <Button Content="中断" Grid.Column="2" Grid.Row="2" Margin="84,5,0,5" HorizontalAlignment="Left" Command="{Binding CloseWindowCommand}" VerticalContentAlignment="Center" IsEnabled="{Binding NowProcessing.CanStop}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Click="Button_Click_1" Width="69" />
    </Grid>
</Window>
